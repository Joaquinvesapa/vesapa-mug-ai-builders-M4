# Copy to .env.local and fill in real values. Never commit real values.

# Local database (compose.yaml). Choose any password; DATABASE_URL must use the same one.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# postgresql://festival:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/festival
DATABASE_URL=

# Auth.js: generate with `npx auth secret` or `openssl rand -hex 32`.
AUTH_SECRET=
# Google OAuth client (optional to try PIN access only).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
